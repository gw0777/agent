# AI Gateway / JEV 설정
# 사용법: 이 파일을 복사해서 .env 로 저장 후 값 채우기
#   cp .env.example .env
#
# 주의: test-jev.js는 .env 파일에서 첫 '=' 뒤의 값만 읽습니다.
#       .env 파일에는 아래 한 줄만 유지하세요 (여러 줄/여러 '=' 혼용 시 파싱이 깨짐).

AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here

# 선택 — router.js / router-ai-sdk.js / router-direct.js 공통
# JEV_API_URL=https://ai-gateway.vercel.sh/v1/evaluate
# JEV_MODEL=typesafe-ai/jev
